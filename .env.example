# ==============================================================================
# VeriAI Environment Configuration Template (.env.example)
# Copy this file to .env and configure keys for your local development.
# ==============================================================================

# Google Gemini API (Recommended for structured claim extraction & explanations)
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Router / DeepSeek (OpenAI-compatible endpoint)
# Obtain a token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here
HF_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017:novita
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1

# Optional Third-Party Providers
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: override local Hugging Face model cache
# HF_HOME=./models_cache
